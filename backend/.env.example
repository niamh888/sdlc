# Copy this file to .env in this same folder, then fill in real values.
# .env is gitignored (see backend/.gitignore) — it never gets committed, and
# its contents never need to be pasted into a chat either, same rule as the
# Resend API key earlier in this project: real secrets only ever go directly
# into this file, typed or pasted by hand in your own editor.

# Neon connection string — Neon dashboard -> your project -> "Connect" ->
# copy the connection string (starts with postgresql://). SQLAlchemy/psycopg
# understand it as-is, no reformatting needed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this example value, and never commit the real one.
JWT_SECRET=replace-this-with-a-generated-secret-before-running-anything-real

# Comma-separated frontend origins allowed to call this API.
# Local dev (python -m http.server 8000):
#   CORS_ORIGINS=http://localhost:8000
# Once deployed, add the real GitHub Pages origin too:
#   CORS_ORIGINS=http://localhost:8000,https://niamh888.github.io
CORS_ORIGINS=http://localhost:8000

# The one login for the /admin review-moderation panel (approve/reject
# reviews — replaces Supabase's Table Editor). Pick your own values here;
# there is no sign-up flow for this, just whatever you put in this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-real-password-before-running-anything-real

# A SECOND generated secret, separate from JWT_SECRET — same command:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-this-with-a-second-generated-secret
